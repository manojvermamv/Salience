CONTROL_PLANE_TOKEN=replace-with-a-long-random-token
DATABASE_URL=postgresql+asyncpg://salience:salience@postgres:5432/salience
TEMPORAL_TARGET=temporal:7233
OBJECT_STORE_ENDPOINT=http://garage:3900
WORKER_TASK_QUEUE=salience-phase-one
MOCK_EFFECT_PROVIDER_URL=http://mock-effect-provider:8081
GARAGE_CONFIG_PATH=./infra/garage/garage.toml

# Optional intelligence-loop integrations. Secret references only; do not add values here.
MODEL_RUNTIME_ID=
MODEL_BASE_URL=
MODEL_NAME=
MODEL_SECRET_REF=env://MODEL_API_KEY
RESEARCH_ALLOWED_DOMAINS=
RESEARCH_RSS_FEED_URLS=
