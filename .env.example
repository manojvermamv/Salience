RESEARCH_MAX_RESPONSE_BYTES=1000000
BROWSER_ENABLED=false
BROWSER_TIMEOUT_SECONDS=30
BROWSER_STEP_LIMIT=20
MCP_ENDPOINT=
MCP_AUTH_SECRET_REF=env://MCP_API_KEY
A2A_ENDPOINT=
A2A_AUTH_SECRET_REF=env://A2A_API_KEY
