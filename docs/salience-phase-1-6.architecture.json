  "cards": [
    {
      "dot": "cyan",
      "title": "What runs now",
      "items": [
        "A dry-run intelligence workflow checkpoints source collection, signals, ranking, strategy, strategic packages, claim checks, and immutable ContentBrief creation.",
        "Restart, retry, idempotency, audit, provenance, budget hooks, and trace identity remain durable project records."
      ]
    },
    {
      "dot": "emerald",
      "title": "What stays governed",
      "items": [
        "Untrusted source content cannot grant authority, become verified memory, choose policy, or invoke write tools.",
        "Scope, policy, approval, dry-run, and budget boundaries apply before external effects."
      ]
    },
    {
      "dot": "violet",
      "title": "What remains deferred",
      "items": [
        "Scripting, media generation, publishing, analytics, experiments, and learning begin only after the immutable brief handoff.",
        "No model credential, production publisher, or remote agent is required; browser evidence is optional and independently verified."
      ]
    }
  ]
